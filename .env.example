# Vurafya Backend - Environment Variables
# Copy to .env and fill in values before deploying
# Product: Vurafya by VuraLabs

# ── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DATABASE_URL=postgresql://cdfd:change-me-postgres-password@localhost:5435/cdfd
POSTGRES_DB=cdfd
POSTGRES_USER=cdfd
POSTGRES_PASSWORD=change-me-postgres-password
NEO4J_PASSWORD=change-me-neo4j-password
JWT_SECRET=replace-with-a-long-random-string-minimum-32-chars
DEBUG=false
APP_BASE_URL=http://localhost:8000
ENGINE_PATH=../CDFD-Runtime
DEMO_EMAIL=director.demo@vurafya.local
DEMO_USERNAME=director_demo
DEMO_PASSWORD=vurafya123
DEMO_LOGIN_ENABLED=true
# These are deliberately off by default. The app works without either worker.
ENABLE_BACKGROUND_WORKER=false
ENABLE_MODEL_AUTOMATIONS=false
RUNTIME_PERSIST_ON_READ=false

# ── Engine (optional CDFD Runtime) ───────────────────────────────────────────
# VURAFYA_USE_RUNTIME_KERNEL=1   # use Runtime kernel for trajectory (default: local)
# RUNTIME_ARTIFACT_ROOT=runtime_runs
# RUNTIME_REQUIRE_FINITE=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development: CORS_ORIGINS=["http://localhost:3000"]
# Production:  CORS_ORIGINS=["https://yourapp.com","vurafya://app"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Firebase (FCM push notifications) ────────────────────────────────────────
# Get from Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=AAAAxxxxxxx:APA91bxxxxxx

# ── Token expiry ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
