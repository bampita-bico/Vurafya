# Vurafya Backend - Environment Variables
# Copy to .env and fill in values before deploying

# ── Core ────────────────────────────────────────────────────────────────────
DB_PATH=AfyaFigo.db
DATABASE_URL=postgresql://cdfd:change-me-postgres-password@localhost:5432/cdfd
POSTGRES_DB=cdfd
POSTGRES_USER=cdfd
POSTGRES_PASSWORD=change-me-postgres-password
NEO4J_PASSWORD=change-me-neo4j-password
JWT_SECRET=replace-with-a-long-random-string-minimum-32-chars
DEBUG=false
APP_BASE_URL=https://api.yourdomain.com
ENGINE_PATH=../CDFD-Runtime
DEMO_EMAIL=director.demo@vurafya.local
DEMO_USERNAME=director_demo
DEMO_PASSWORD=change-me-demo-password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development: CORS_ORIGINS=["*"]
# Production:  CORS_ORIGINS=["https://yourapp.com","vurafya://app"]
CORS_ORIGINS=["*"]

# ── FlutterWave (mobile money payments) ──────────────────────────────────────
# Get from https://dashboard.flutterwave.com/dashboard/settings/apis
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_HASH=your-webhook-secret-hash

# ── Firebase (FCM push notifications) ────────────────────────────────────────
# Get from Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=AAAAxxxxxxx:APA91bxxxxxx

# ── Token expiry ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
